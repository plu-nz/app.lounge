{
  "name": "lounge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:frontend": "vite",
    "build:frontend": "tsc --noEmit && vite build",
    "build": "pnpm build:frontend && go build -o build/lounge .",
    "check": "tsc --noEmit && go vet ./... && go test ./..."
  },
  "dependencies": {
    "@plunz/storybook": "github:plu-nz/lib.storybook#3449d90",
    "@wailsio/runtime": "3.1.0",
    "lucide-solid": "^1.75.0",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.8"
  }
}
